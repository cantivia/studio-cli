{
  "name": "studio-cli",
  "version": "0.1.6",
  "description": "Terminals and Claude Code sessions in one calm window, on your Mac, reachable from your phone.",
  "private": true,
  "license": "MIT",
  "homepage": "https://studio-cli.cantivia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cantivia/studio-cli.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true",
    "build:office": "cd vendor/pixel-agents/webview-ui && npx vite build",
    "setup": "node scripts/setup.mjs",
    "invite": "node scripts/invite.mjs",
    "app": "node scripts/build-app.mjs",
    "app:dir": "node scripts/build-app.mjs --dir",
    "switch-to-app": "node scripts/switch-to-app.mjs",
    "test:update": "node --test electron/update-core.test.cjs",
    "release": "node scripts/release.mjs",
    "release:key": "node scripts/release.mjs key",
    "test": "node --test electron/update-core.test.cjs && node --import tsx --test server/links-core.test.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.3.0",
    "framer-motion": "^14.1.0",
    "lucide-react": "^1.55.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
