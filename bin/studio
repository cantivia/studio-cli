#!/usr/bin/env bash
# Studio CLI. Inside a Studio pane, STUDIO_URL and STUDIO_TERMINAL_ID are set,
# so `studio notify "tests passed"` rings the pane you ran it from.
set -euo pipefail
URL="${STUDIO_URL:-http://127.0.0.1:4600}"
json() { node -e 'console.log(JSON.stringify(Object.fromEntries(process.argv.slice(1).map(a=>a.split(/=(.*)/s).slice(0,2)))))' "$@"; }

case "${1:-help}" in
  notify)
    shift
    body="${1:-Done}"; title="${2:-${PWD##*/}}"
    curl -fsS -X POST "$URL/api/notify" -H 'content-type: application/json' \
      -d "$(json "title=$title" "body=$body" "termId=${STUDIO_TERMINAL_ID:-}")" >/dev/null ;;
  send)
    # studio send <terminal-id> "text"   (presses Enter after)
    curl -fsS -X POST "$URL/api/terminals/$2/send" -H 'content-type: application/json' \
      -d "$(node -e 'console.log(JSON.stringify({text:process.argv[1],enter:true}))' "$3")" >/dev/null ;;
  ls)
    curl -fsS "$URL/api/state" | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{const s=JSON.parse(d);for(const t of s.terminals){const m=s.meta[t.id]||{};console.log([t.id,m.claude?"claude:"+m.claude.status:"shell",m.cwd||t.cwd].join("\t"))}})' ;;
  *)
    echo "usage: studio notify <body> [title] | studio send <terminal-id> <text> | studio ls" ;;
esac
